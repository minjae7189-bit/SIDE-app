<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK: 기어 상태 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- TextToSpeech SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- SpeechToText SDK: 아이의 답 인식. 마이크 녹음은 Pleos 음성 서비스가 한다. -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- NaviHelper SDK: 차량 현재 위치·목적지 읽기(NAVI_ROUTE), 경로·경유지 요청(NAVI_ROUTE_SEARCH) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 가 볼 만한 곳 추천: 현재 위치에서 가까운 문화시설을 찾는다. 대략 위치만으로도 동작한다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 대체 엔진(안드로이드 기본 TTS)이 Android 11+ 패키지 가시성 제한에서 엔진 서비스를 찾을 수 있도록 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Side">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <!-- 주행 중에도 화면이 차단되지 않도록 선언. 주행 중 UI는 음성 위주 최소 화면만 보여 준다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
